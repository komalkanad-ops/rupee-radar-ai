# Database — MySQL. On a Hostinger VPS: run via docker-compose.yml. On Hostinger shared hosting +
# an externally-hosted backend (Render, etc.): use the MySQL database already on your hosting plan
# (hPanel → Databases → MySQL Databases) and enable Remote MySQL access for it.
DATABASE_URL="mysql://rupeeradar:changeme@localhost:3306/rupeeradarai"

PORT=4000
JWT_SECRET="changeme-generate-a-long-random-string"
ADMIN_BOOTSTRAP_EMAIL="admin@rupeeradarai.com"
ADMIN_BOOTSTRAP_PASSWORD="changeme"

# mesh-api — same contract as mesh-cli/mesh.js (OpenAI-compatible chat completions router)
MESH_API_KEY=
MESH_BASE_URL="https://api.meshapi.ai/v1"
MESH_MODEL="anthropic/claude-sonnet-4.5"

# Google Cloud project with Places API enabled — needed for the nearby-store card
# recommendation feature (Croma/Reliance Digital lookup). Provision this yourself in
# Google Cloud Console and restrict the key to Places API + your server IP.
GOOGLE_PLACES_API_KEY=

# Play Console service account JSON (base64 or path) — needed to verify PRO subscription
# purchases server-side via the Google Play Developer API.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME="com.rupeeradarai.app"

# Lets you unlock PRO in the app during testing without Play Billing — POST /billing/redeem-test-code
# with this code. Unset (or remove the route) before a public launch.
PRO_TEST_REDEEM_CODE="RUPEE-PRO-TEST"

# Setu Account Aggregator sandbox — sign up (free, self-serve) at aa-bridge.setu.co/signup, create
# a child org, and copy these from the Bridge dashboard. SETU_BASE_URL is issued per-org, not a
# fixed public hostname — there's no sensible default. Bank-linking 501s cleanly until all four
# are set.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_BASE_URL=

# Razorpay test-mode keys — free, self-serve, no KYC required (Dashboard -> Account & Settings ->
# API Keys, in Test Mode). RAZORPAY_WEBHOOK_SECRET is set separately when you configure a webhook
# URL in the Razorpay dashboard (Settings -> Webhooks) — it's a secret you choose, not one they give you.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
